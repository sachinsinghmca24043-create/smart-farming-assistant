# Copy to .env locally. Never commit the real .env file.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required for admin APIs. Generate a long random value (32+ bytes).
ADMIN_API_KEY=replace-with-a-long-random-secret

# Existing Gemini integration
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Optional integrations to configure in later Milestone 3 steps
SARVAM_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional backend settings
SMART_FARMING_DB_PATH=./smart_farming.db
MAX_AUDIO_BYTES=10485760
